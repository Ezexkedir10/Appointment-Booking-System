# PostgreSQL connection string (local example: docker compose up -d db)
DATABASE_URL="postgresql://appointiq:appointiq@localhost:5433/appointiq?schema=public"

# Separate database used only by `npm test` integration tests (tests truncate its tables).
TEST_DATABASE_URL="postgresql://appointiq:appointiq@localhost:5433/appointiq_test?schema=public"

# Optional seed settings
SEED_ADMIN_PASSWORD="change-me-please"
SEED_TIME_ZONE="America/New_York"
